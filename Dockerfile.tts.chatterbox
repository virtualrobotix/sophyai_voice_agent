FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    libsndfile1 \
    espeak-ng \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    numpy \
    soundfile \
    scipy \
    pydantic \
    aiohttp \
    requests \
    edge-tts

RUN pip3 install --no-cache-dir \
    torch \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip3 install --no-cache-dir chatterbox-tts

COPY tts_server.py /app/tts_server.py
COPY agent/tts/ /app/agent/tts/

ENV TTS_ALLOWED_ENGINES=chatterbox
ENV TTS_BOOT_ENGINE=edge
ENV HF_HOME=/app/models

RUN mkdir -p /app/models

EXPOSE 8092

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
    CMD curl -f http://localhost:8092/health || exit 1

CMD ["python3", "tts_server.py", "--port", "8092"]
