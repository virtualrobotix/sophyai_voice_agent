# TTS Server con supporto CUDA - Tutti gli engine
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

# Evita prompt interattivi durante l'installazione
ENV DEBIAN_FRONTEND=noninteractive

# Installa Python 3.12 e dipendenze sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    espeak-ng \
    sox \
    libsox-fmt-all \
    git \
    curl \
    wget \
    build-essential \
    ninja-build \
    pkg-config \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Usa Python 3.12 come default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --set python3 /usr/bin/python3.12

WORKDIR /app

# Installa pip per Python 3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

# Aggiorna pip e installa build tools
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel build

# Installa PyTorch con CUDA 12.1
RUN pip3 install --no-cache-dir \
    torch \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu121

# Installa dipendenze Python base per TTS
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    numpy \
    soundfile \
    scipy \
    pydantic \
    huggingface_hub \
    requests \
    aiohttp \
    loguru \
    transformers==4.57.3 \
    accelerate \
    safetensors \
    sentencepiece

# ========================================
# TTS ENGINE 1: Edge TTS (Microsoft Cloud) - SEMPRE FUNZIONA
# ========================================
RUN pip3 install --no-cache-dir edge-tts && \
    python3 -c "import edge_tts; print('✅ Edge TTS installato')"

# ========================================
# TTS ENGINE 2: Kokoro TTS (Self-hosted) - PRIORITÀ ALTA
# ========================================
RUN pip3 install --no-cache-dir "kokoro>=0.3.4" && \
    python3 -c "import kokoro; print('✅ Kokoro TTS installato')"

# ========================================
# TTS ENGINE 3: Qwen TTS (Alibaba - Self-hosted) - PRIORITÀ ALTA
# ========================================
RUN pip3 install --no-cache-dir qwen-tts && \
    python3 -c "from qwen_tts import Qwen3TTSModel; print('✅ Qwen TTS installato')"

# ========================================
# TTS ENGINE 3b: VibeVoice (Microsoft, opzionale)
# ========================================
RUN pip3 install --no-cache-dir "git+https://github.com/microsoft/VibeVoice.git" || \
    echo "⚠️ VibeVoice non installato (opzionale)"

# ========================================
# TTS ENGINE 4: Piper TTS (Self-hosted, veloce)
# ========================================
RUN pip3 install --no-cache-dir piper-tts pathvalidate && \
    python3 -c "from piper import PiperVoice; print('✅ Piper TTS installato')"

# ========================================
# TTS ENGINE 5: Chatterbox TTS (Self-hosted, voice cloning) - OPZIONALE
# ========================================
RUN pip3 install --no-cache-dir chatterbox-tts || \
    echo "⚠️ Chatterbox TTS non installato (opzionale)"

# Chatterbox può aggiornare transformers a versioni incompatibili con qwen-tts.
# Ripristina una versione compatibile con qwen-tts.
RUN pip3 install --no-cache-dir --force-reinstall "transformers==4.57.3"

# ========================================
# TTS ENGINE 6: Coqui TTS (Self-hosted, alta qualità) - OPZIONALE  
# ========================================
RUN pip3 install --no-cache-dir TTS || \
    echo "⚠️ Coqui TTS non installato (opzionale)"

# ========================================
# FlashAttention 2 per prestazioni ottimali (opzionale)
# ========================================
RUN pip3 install --no-cache-dir flash-attn --no-build-isolation || \
    echo "⚠️ FlashAttention non installato (non critico)"

# Copia il server TTS e moduli necessari
COPY tts_server.py .
COPY agent/tts/ ./agent/tts/

# Directory per i modelli
RUN mkdir -p /app/models /app/models/piper
ENV HF_HOME=/app/models

# Pre-download modelli Piper italiano
RUN mkdir -p /app/models/piper && \
    curl -L -o /app/models/piper/it_IT-riccardo-x_low.onnx \
    "https://huggingface.co/rhasspy/piper-voices/resolve/main/it/it_IT/riccardo/x_low/it_IT-riccardo-x_low.onnx" && \
    curl -L -o /app/models/piper/it_IT-riccardo-x_low.onnx.json \
    "https://huggingface.co/rhasspy/piper-voices/resolve/main/it/it_IT/riccardo/x_low/it_IT-riccardo-x_low.onnx.json" && \
    echo "✅ Modello Piper italiano scaricato" || echo "⚠️ Download modello Piper fallito"

# Verifica finale installazioni
RUN echo "=== VERIFICA INSTALLAZIONI ===" && \
    (python3 -c "import edge_tts; print('✅ edge-tts')" || echo "❌ edge-tts") && \
    (python3 -c "import kokoro; print('✅ kokoro')" || echo "❌ kokoro") && \
    (python3 -c "from qwen_tts import Qwen3TTSModel; print('✅ qwen-tts')" || echo "❌ qwen-tts") && \
    (python3 -c "import vibevoice; print('✅ vibevoice')" || echo "❌ vibevoice") && \
    (python3 -c "from piper import PiperVoice; print('✅ piper-tts')" || echo "❌ piper-tts") && \
    (python3 -c "from chatterbox.tts import ChatterboxTTS; print('✅ chatterbox-tts')" || echo "❌ chatterbox-tts") && \
    (python3 -c "from TTS.api import TTS; print('✅ coqui-tts')" || echo "❌ coqui-tts") && \
    echo "=== FINE VERIFICA ==="

# Variabili di default
ENV DEFAULT_TTS=edge
ENV TTS_PORT=8092
ENV CUDA_VISIBLE_DEVICES=0

EXPOSE 8092

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8092/health || exit 1

CMD ["python3", "tts_server.py"]
